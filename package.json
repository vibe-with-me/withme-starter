{
  "name": "withme-starter",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase/seed"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "bun run supabase/seed/index.ts",
    "db:unseed": "bun run supabase/seed/unseed.ts",
    "db:types": "supabase gen types typescript --local > packages/db/src/types/supabase.ts",
    "db:provision": "bun run supabase/seed/provision.ts"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7"
  },
  "overrides": {
    "expo": "56.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "seroval": "^1.6.9",
    "seroval-plugins": "^1.6.9"
  }
}
