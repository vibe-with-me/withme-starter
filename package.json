{
  "name": "withme-starter",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase/seed"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "bun run supabase/seed/index.ts",
    "db:unseed": "bun run supabase/seed/unseed.ts",
    "db:types": "supabase gen types typescript --local > packages/db/src/types/supabase.ts.tmp && prettier --parser typescript --no-semi --trailing-comma all --print-width 80 --write packages/db/src/types/supabase.ts.tmp && mv packages/db/src/types/supabase.ts.tmp packages/db/src/types/supabase.ts",
    "db:provision": "bun run supabase/seed/provision.ts",
    "sync:check": "bash scripts/upstream-redefines.sh"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "expo": "57.0.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "seroval": "^1.6.9",
    "seroval-plugins": "^1.6.9",
    "source-map-js": "^1.2.2"
  }
}
