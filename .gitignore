# Dependencies
node_modules

# Build output
dist
build

# Test coverage
coverage

# Verification screenshots (the feature-dev skill)
.verify-screenshots/

# Environment files
.env
.env.*
!.env.example

# Cloudflare Workers local state
.wrangler
.dev.vars
.dev.vars.*
!.dev.vars.example
worker-configuration.d.ts

# Turborepo
.turbo

# Playwright
test-results
playwright-report

# Expo. ios/ and android/ are generated by `expo prebuild` (the app is managed:
# app.json is the source of truth), and they collect signing files.
.expo
expo-env.d.ts
apps/mobile/ios/
apps/mobile/android/

# Signing keys, store credentials and Firebase configs: never commit these.
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Claude Code: per-machine settings and worktrees. The skill links are shared.
.claude/*
!.claude/skills/

# OS
.DS_Store

# Logs
*.log

# Note: bun.lockb is intentionally tracked — do not ignore it.

# Supabase CLI scratch: rewritten on every `supabase start`, and newer CLIs write start-secrets/ here.
supabase/.temp/
supabase/.branches/

# Operator secrets an older go-live or provision run may have left in the repo root.
.supabase-demo-db-password
provisioned-tags.*

# The go-live skill's throwaway sign-in probe (it reads the demo credentials).
apps/web/authed-check.ts

# Maestro (mobile e2e) screenshots and reports
apps/mobile/e2e/.maestro/
