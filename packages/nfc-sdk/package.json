{
  "name": "@vibewithme/nfc",
  "version": "0.1.0",
  "description": "NFC-to-destination redirect SDK: resolve tag UIDs to destinations, log scans, bring your own storage.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibe-with-me/withme-starter.git",
    "directory": "packages/nfc-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./storage/supabase": {
      "import": {
        "types": "./dist/storage/supabase.d.ts",
        "default": "./dist/storage/supabase.js"
      },
      "require": {
        "types": "./dist/storage/supabase.d.cts",
        "default": "./dist/storage/supabase.cjs"
      }
    },
    "./storage/memory": {
      "import": {
        "types": "./dist/storage/memory.d.ts",
        "default": "./dist/storage/memory.js"
      },
      "require": {
        "types": "./dist/storage/memory.d.cts",
        "default": "./dist/storage/memory.cjs"
      }
    },
    "./adapters/hono": {
      "import": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "require": {
        "types": "./dist/adapters/hono.d.cts",
        "default": "./dist/adapters/hono.cjs"
      }
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@orpc/client": "^1.13.6"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@orpc/contract": "^1.15.5",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^22.20.5",
    "@withme/contract": "workspace:*",
    "hono": "^4.13.13",
    "publint": "0.3.25",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
