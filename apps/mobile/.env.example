# Copy to .env (gitignored). Local-stack shared defaults — not secrets.
# The iOS simulator reaches the host machine via localhost directly.
EXPO_PUBLIC_API_URL=http://localhost:8786
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Optional: your store. Adds the Merch tab.
# EXPO_PUBLIC_STORE_URL=https://shop.example.com
# Your terms of use and privacy policy (docs/terms-template.md is the starting
# text). Sign-up and the re-ask screen link to them; set both before go-live.
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
