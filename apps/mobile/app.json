{
  "expo": {
    "name": "withme",
    "slug": "withme-starter",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "withme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.withme.starter"
    },
    "android": {
      "package": "co.withme.starter",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#f3efe8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141210"
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Read withme tags to connect with people.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile.",
          "cameraPermission": "Scan someone's code to open their card.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan someone's code to open their card.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "owner": "vibe-with-me",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf56d2f1-eaec-406b-be9c-972519a6be84"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf56d2f1-eaec-406b-be9c-972519a6be84"
    }
  }
}
