{
  "expo": {
    "name": "withme",
    "slug": "withme-starter",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "withme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.withme.starter"
    },
    "android": {
      "package": "co.withme.starter",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe8",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3efe8",
          "dark": {
            "backgroundColor": "#141210"
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Read withme tags to connect with people.",
          "includeNdefEntitlement": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "vibe-with-me",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf56d2f1-eaec-406b-be9c-972519a6be84"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf56d2f1-eaec-406b-be9c-972519a6be84"
    }
  }
}
