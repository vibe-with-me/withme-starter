{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 8786 (not wrangler's 8787 default) so this coexists with another local
  // Workers project, matching the 55xxx Supabase port choice.
  "dev": {
    "port": 8786
  },
  // CORS_ORIGIN deliberately absent here: the code defaults to
  // http://localhost:3000 for local dev, and deployments set it as a secret
  // (wrangler secret put) so `wrangler deploy` can never clobber it.
  "vars": {
    "APP_ENV": "development"
  },
  "ratelimits": [
    {
      "name": "SCAN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    // Resolves per caller IP across every tag: one client walking through
    // UIDs. Generous, because a venue's Wi-Fi puts a crowd behind one IP.
    {
      "name": "RESOLVE_IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
  // Per-deployment config (set as vars for your Worker, or .dev.vars locally —
  // see .dev.vars.example): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.
  // The service-role key is never configured here, by design.
}
