# Copy to .env (gitignored); a deploy reads .env.production. Build-time only,
# all public, none secret. Every line is optional.
# The origin this site deploys to (canonical URLs).
# PUBLIC_SITE_URL=https://example.com
# The web app's origin. Adds "Open the app"; unset, the button is left out.
# PUBLIC_APP_URL=http://localhost:3000
# The store, the same value as the app's VITE_STORE_URL. Adds "Get tags".
# PUBLIC_STORE_URL=https://shop.example.com
