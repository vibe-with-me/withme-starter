{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "packages/db/src/types/supabase.ts"
  ],
  "overrides": [
    {
      "files": [
        "apps/mobile/**"
      ],
      "rules": {
        "react/style-prop-object": "off"
      }
    }
  ]
}
